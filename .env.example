# Backend selection ("local" or "api")
LLM_BACKEND=local
IMAGE_BACKEND=local

# Game mode ("online" | "offline_local" | "offline_static")
GAME_MODE=online

# Anthropic (required when LLM_BACKEND=api)
ANTHROPIC_API_KEY=

# fal.ai (required when IMAGE_BACKEND=api)
FAL_KEY=

# HuggingFace (required when LLM_BACKEND=local)
hf_write_read=

# Google GenAI / Lyria 3 music generation (required when MUSIC_BACKEND=api)
# Get an API key at https://aistudio.google.com/apikey
MUSIC_BACKEND=none
GOOGLE_API_KEY=

# ElevenLabs SFX generation (used when MUSIC_BACKEND=api)
# Get an API key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Audio volume (0-100)
MASTER_VOLUME=80
MUSIC_VOLUME=60
SFX_VOLUME=70

# Image generation size (pixels)
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# LLM story context window limit (characters)
STORY_CONTEXT_LIMIT=1000

# Post-generation player guide ("true" to auto-generate after world_gen)
GENERATE_GUIDE=false
